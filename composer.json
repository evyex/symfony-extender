{
    "name": "evyex/symfony-extender",
    "description": "Symfony bundle to must have features",
    "type": "symfony-bundle",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "symfony/validator": "^7.4",
        "symfony/http-kernel": "^7.4.12",
        "symfony/dependency-injection": "^7.4",
        "doctrine/dbal": "^3.10|^4",
        "doctrine/orm": "^3",
        "symfony/serializer": "^7.4",
        "symfony/expression-language": "^7.4",
        "symfony/property-access": "^7.4",
        "symfony/security-core": "^7.4",
        "symfony/security-http": "^7.4.13",
        "symfony/config": "^7.4",
        "symfony/property-info": "^7.4",
        "symfony/process": "^7.4.5",
        "symfony/http-foundation": "^7.4.13",
        "symfony/routing": "^7.4.13",
        "symfony/cache": "^7.4.12"
    },
    "autoload": {
        "psr-4": {
            "Evyex\\SymfonyExtender\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Evyex\\SymfonyExtender\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Evgenij Yurchenko",
            "email": "evgenijvy@gmail.com"
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^11.5.50|^12.5.8",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.92",
        "symfony/framework-bundle": "^7.4",
        "symfony/security-bundle": "^7.4",
        "doctrine/doctrine-bundle": "^2.14",
        "symfony/var-exporter": "^7.4"
    }
}
