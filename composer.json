{
    "name": "evyex/symfony-extender",
    "description": "Symfony bundle to must have features",
    "type": "symfony-bundle",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "symfony/validator": "^6.4.11",
        "symfony/http-kernel": "^6.4.15",
        "symfony/dependency-injection": "^6.4",
        "doctrine/orm": "^3",
        "doctrine/dbal": "^3.10|^4",
        "symfony/serializer": "^6.4",
        "symfony/expression-language": "^6.4",
        "symfony/property-access": "^6.4",
        "symfony/security-core": "^6.4",
        "symfony/security-http": "^6.4.15",
        "symfony/property-info": "^6.4"
    },
    "autoload": {
        "psr-4": {
            "Evyex\\SymfonyExtender\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Evyex\\SymfonyExtender\\Tests\\": "tests/"
        }
    },
    "extra": {
        "symfony": {
            "require": "6.4.*"
        }
    },
    "authors": [
        {
            "name": "Evgenij Yurchenko",
            "email": "evgenijvy@gmail.com"
        }
    ],
    "require-dev": {
        "phpunit/phpunit": ">=10",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.92",
        "symfony/framework-bundle": "^6.4",
        "symfony/security-bundle": "^6.4",
        "doctrine/doctrine-bundle": "^2.14",
        "symfony/var-exporter": "^6.4"
    }
}
