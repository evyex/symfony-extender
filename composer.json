{
    "name": "evyex/symfony-extender",
    "description": "Symfony bundle to must have features",
    "type": "symfony-bundle",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "symfony/validator": "8.0.*",
        "symfony/http-kernel": "~8.0.12",
        "symfony/dependency-injection": "8.0.*",
        "doctrine/orm": "^3.5.4",
        "symfony/serializer": "8.0.*",
        "symfony/expression-language": "8.0.*",
        "symfony/property-access": "8.0.*",
        "symfony/security-core": "8.0.*",
        "symfony/security-http": "~8.0.13",
        "symfony/config": "8.0.*",
        "symfony/property-info": "8.0.*",
        "symfony/process": "~8.0.5",
        "symfony/http-foundation": "~8.0.13",
        "symfony/routing": "~8.0.13",
        "symfony/cache": "~8.0.12"
    },
    "autoload": {
        "psr-4": {
            "Evyex\\SymfonyExtender\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Evyex\\SymfonyExtender\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Evgenij Yurchenko",
            "email": "evgenijvy@gmail.com"
        }
    ],
    "require-dev": {
        "phpunit/phpunit": ">=12.5.8|^13.0",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.92",
        "symfony/framework-bundle": "8.0.*",
        "symfony/security-bundle": "8.0.*",
        "doctrine/doctrine-bundle": "^3.1",
        "symfony/var-exporter": "8.0.*"
    }
}
